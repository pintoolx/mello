# Backend environment: copy this to apps/api/.env.
# App (`NODE_ENV` defaults to development; set it explicitly in production.)
CORE_API_PORT=4000
CORE_API_HOST=127.0.0.1
SELLER_BIND_HOST=127.0.0.1
SELLER_A_PORT=4011
SELLER_B_PORT=4012
WEB_ORIGIN=http://localhost:3000
CORE_API_URL=http://localhost:4000
DEMO_ADMIN_TOKEN=change-me-before-public-deploy
# Required in production; shared with the Next.js server, never the browser.
API_ACCESS_TOKEN=

# Database
# Runtime client URL; a deployed environment may use its pooler here.
DATABASE_URL=postgresql://mello:mello@localhost:5432/mello?schema=public
# Direct/unpooled URL used by Prisma validation and migrations.
DIRECT_DATABASE_URL=postgresql://mello:mello@localhost:5432/mello?schema=public

# Procurement agent
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=

# Explicit rollout switch: bazaar has no local fallback and requires reviewed,
# public services actually discoverable in the CDP catalog.
SERVICE_DISCOVERY_MODE=local_demo
BAZAAR_TIMEOUT_MS=5000
# Seller-only opt-in; requires PAYMENT_MODE=x402 + public HTTPS SELLER_*_URL.
BAZAAR_PUBLIC_ENABLED=false

# x402 — mock is the safe local default; use x402 only with a funded test-only wallet
PAYMENT_MODE=mock
X402_FACILITATOR_URL=https://x402.org/facilitator
# Required only when using https://api.cdp.coinbase.com/platform/v2/x402.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_NETWORK=eip155:84532
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_TOKEN_DECIMALS=6
EVM_PRIVATE_KEY=
FUND_CHECK_MIN_USDC_ATOMIC=150000
# The testnet smoke refuses to sign or submit unless this is explicitly true.
MELLO_TESTNET_PAYMENT_APPROVED=false
SELLER_A_PAY_TO=0x1111111111111111111111111111111111111111
SELLER_B_PAY_TO=0x2222222222222222222222222222222222222222
SELLER_A_URL=http://localhost:4011
SELLER_B_URL=http://localhost:4012
SELLER_CONTEXT_HMAC_SECRET=change-me-with-at-least-32-random-characters

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_BASE_URL=https://sepolia.basescan.org

# Contract anchor
CONTRACT_ANCHOR_MODE=mock
CONTRACT_OPERATOR_PRIVATE_KEY=
AUDIT_REGISTRY_ADDRESS=
DEMO_ALLOW_OFFCHAIN_AUTH=false

# Durable workflow worker tuning
WORKFLOW_POLL_INTERVAL_MS=250
WORKFLOW_LEASE_MS=60000
WORKFLOW_BACKOFF_BASE_MS=1000
WORKFLOW_MAX_ATTEMPTS=3

# Ethereum standards (ERC-8004/8196 values are reserved and unused while their flags remain false.)
ERC3009_RECORDING_ENABLED=true
ERC3009_AUTH_TTL_SECONDS=300
ERC8004_IDENTITY_ENABLED=false
ERC8004_REPUTATION_ENABLED=false
ERC8004_RPC_URL=
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_CHAIN_ID=
ERC8004_RESOLVE_TIMEOUT_MS=1500
ERC8196_WALLET_ENABLED=false

# Invoice (ECPay Stage values are reserved for a post-P0 adapter and unused in this build.)
INVOICE_PROVIDER=mock
DEMO_TWD_PER_USDC=32.0
# Normal Demo invoices succeed on their first issue attempt.
# Set true only for an explicitly requested invoice-recovery fault-injection test.
MOCK_INVOICE_FAIL_ONCE=false
ECPAY_STAGE_MERCHANT_ID=
ECPAY_STAGE_HASH_KEY=
ECPAY_STAGE_HASH_IV=
